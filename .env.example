# Anthropic Claude — server-side only (proxied at /api/llm). Never use VITE_ prefix for secrets.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional model override (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase Postgres — server-side only (proxied at /api/db). Never commit real credentials.
# Project: https://supabase.com/dashboard/project/YOUR_PROJECT_REF/settings/database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Public site URL for SEO (canonical, sitemap, Open Graph). No trailing slash.
# VITE_SITE_URL=https://codebwoy.github.io/aridscanlogic
# Base path when hosted on GitHub Pages project site (trailing slash required).
# VITE_BASE_PATH=/aridscanlogic/

# Supabase Auth (public anon key + URL are safe in client; service role and JWT secret are server-only).
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard
# Never use VITE_ for service role — use SUPABASE_SERVICE_ROLE_KEY below instead.

# Required when exposing the dev server on your LAN (npm run dev:lan).
# Paste the same value in Settings → Remote API access (session-only, not in the client bundle).
# SCANLOGIC_API_SECRET=generate-a-long-random-string-here

# Postgres TLS — verify server certificates (default). Set to false only if connection fails with Supabase.
# SCANLOGIC_PG_SSL_REJECT_UNAUTHORIZED=false

# Vercel Cron / external cron keep-alive (server-only). Generate: openssl rand -base64 32
# Value is the secret only — do not include "Bearer". Cron sends: Authorization: Bearer <secret>
# CRON_SECRET=your-generated-secret
#
# Admin dashboard API (server-only). Generate: openssl rand -base64 32
# Open admin UI at ?admin=1 — enter this secret at sign-in (session only, not in client bundle).
# ADMIN_API_SECRET=your-generated-admin-secret
#
# Keep-alive needs ONE of these on Vercel (Production):
#   Option A (recommended): SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#   Option B: DATABASE_URL (Postgres connection string)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# eBay Sell API (Listing Engine OAuth publish) — server-only, never VITE_*
# Create an app at https://developer.ebay.com/ — enable OAuth, add RuName redirect:
#   https://YOUR_HOST/api/ebay/oauth/callback  (dev: http://localhost:5173/api/ebay/oauth/callback)
# EBAY_CLIENT_ID=your-app-client-id
# EBAY_CLIENT_SECRET=your-cert-id-secret
# EBAY_RU_NAME=Your_RuName_Here
# EBAY_ENV=sandbox
# Optional: pin postMessage origin for OAuth popup (defaults to *)
# EBAY_APP_ORIGIN=http://localhost:5173
# Optional scope override (space-separated). Defaults:
#   sell.inventory + sell.account + sell.fulfillment + sell.analytics.readonly
# EBAY_SCOPES=https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.account https://api.ebay.com/oauth/api_scope/sell.fulfillment https://api.ebay.com/oauth/api_scope/sell.analytics.readonly
# Catalog publish defaults to dry-run in the UI; turn on LIVE only after sandbox testing.
# Prefer EBAY_ENV=sandbox until selling limits and feeds are proven.
# After changing EBAY_SCOPES: disconnect & reconnect eBay in the app so consent includes Analytics.
