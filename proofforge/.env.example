# ProofForge — never put secrets in VITE_*

PROOFFORGE_LLM_PROVIDER=fake
# PROOFFORGE_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Optional dual-model verifier (disagreements preserved for author review)
# PROOFFORGE_VERIFY_PROVIDER=openai
# OPENAI_API_KEY=sk-...

PROOFFORGE_API_PORT=8790
PROOFFORGE_API_HOST=127.0.0.1
PROOFFORGE_WEB_ORIGIN=http://localhost:5183,http://127.0.0.1:5183,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5182,http://127.0.0.1:5182

# Required in production (≥32 chars)
# PROOFFORGE_SESSION_SECRET=

# Optional
# PROOFFORGE_API_SECRET=
# PROOFFORGE_PUBLIC_HOST=
# PROOFFORGE_TRIAL_CREDITS=200
# PROOFFORGE_PERSIST=1
# PROOFFORGE_DATA_PATH=/data/proofforge.json
# PROOFFORGE_RATE_LIMIT_MAX=120
# PROOFFORGE_MODEL_DRAFT=claude-sonnet-4-6
# PROOFFORGE_MODEL_CHEAP=claude-haiku-4-5-20251001

# Personal studio — no Stripe. Audits are unlimited locally.

# OCR for thin/scanned PDFs (default on; set 0 to disable)
# PROOFFORGE_OCR=1
# PROOFFORGE_OCR_MAX_PAGES=40

# External plagiarism — NEVER runs without project plagiarism_consent
# PROOFFORGE_PLAGIARISM_PROVIDER=mock
# PROOFFORGE_PLAGIARISM_PROVIDER=http
# PROOFFORGE_PLAGIARISM_URL=https://your-vendor/scan
# PROOFFORGE_PLAGIARISM_API_KEY=
