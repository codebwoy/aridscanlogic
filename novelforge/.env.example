# NovelForge — server secrets only. Never use VITE_ for secrets.
# Generate: openssl rand -base64 48

# HMAC signing for desktop studio sessions (required in production)
NOVELFORGE_SESSION_SECRET=replace-with-long-random-string

# Optional shared secret for non-local API access (Bearer)
NOVELFORGE_API_SECRET=

# Public web origin (CORS allowlist). Include ScanLogic Vite ports for Amazon Hub /health probe.
NOVELFORGE_WEB_ORIGIN=http://localhost:5182,http://127.0.0.1:5182,http://localhost:5173,http://127.0.0.1:5173

# API listen (production/Docker: host 0.0.0.0 via NODE_ENV=production; PORT/8080 on Fly)
NOVELFORGE_API_HOST=127.0.0.1
NOVELFORGE_API_PORT=8789
# NOVELFORGE_PUBLIC_HOST=novelforge.example.com
# (Fly standby: scanlogic-novelforge.fly.dev)
# Serve built SPA from apps/web/dist (hybrid container)
# NOVELFORGE_SERVE_STATIC=1
# NOVELFORGE_WEB_DIST=/absolute/path/to/apps/web/dist

# Redis for BullMQ (optional — in-process queue when unset)
# REDIS_URL=redis://127.0.0.1:6379

# Postgres (optional — memory store when unset)
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/novelforge

# ─── LLM (Recommendation C: NovelForge owns the gateway) ───────────────────
# fake = deterministic fixtures (default for tests / offline)
# anthropic = direct Anthropic SDK call from NovelForge API (not ScanLogic /api/llm)
NOVELFORGE_LLM_PROVIDER=fake
# Same key as ScanLogic is OK — do NOT put in VITE_*
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# NOVELFORGE_MODEL_DRAFT=claude-sonnet-4-6
# NOVELFORGE_MODEL_CHEAP=claude-haiku-4-5-20251001
# NOVELFORGE_MODEL_POLISH=claude-opus-4-6

# Budget cap per book (EUR estimate for display)
NOVELFORGE_BOOK_BUDGET_EUR=8

# Stripe (storefront + SaaS credits — test mode)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_BOOK_CREDIT=

# Market data (Phase 8) — mock by default; never scrape Amazon
NOVELFORGE_MARKET_PROVIDER=mock
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# Image / cover (Phase 6)
NOVELFORGE_IMAGE_PROVIDER=mock
# REPLICATE_API_TOKEN=

# Originality (Phase 4) — internal n-gram by default
NOVELFORGE_ORIGINALITY_PROVIDER=internal

# Fact-check search (Phase 4) — mock by default; never auto-marks verified
NOVELFORGE_SEARCH_PROVIDER=mock
# TAVILY_API_KEY=


# Credits
NOVELFORGE_TRIAL_CREDITS=200
NOVELFORGE_DAILY_CREDIT_CAP=800
NOVELFORGE_DESKTOP_MIN_WIDTH=1024

# Persist books/credits under novelforge/.data
NOVELFORGE_PERSIST=1
# NOVELFORGE_DATA_PATH=/absolute/path/to/state.json

# Signed export / download TTL (ms)
NOVELFORGE_EXPORT_TTL_MS=7200000
