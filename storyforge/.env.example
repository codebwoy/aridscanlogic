# StoryForge — server secrets only. Never use VITE_ for secrets.
# Generate: openssl rand -base64 48

# HMAC signing for desktop studio sessions (required in production)
STORYFORGE_SESSION_SECRET=replace-with-long-random-string

# Optional shared secret for non-local API access (Bearer)
STORYFORGE_API_SECRET=

# Public web origin (CORS allowlist). Comma-separated.
# Include ScanLogic Vite ports so Amazon Hub can probe /health before opening.
STORYFORGE_WEB_ORIGIN=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5173,http://127.0.0.1:5173

# API listen (production/Docker: 0.0.0.0 when NODE_ENV=production; PORT/8080 on Fly)
STORYFORGE_API_HOST=127.0.0.1
STORYFORGE_API_PORT=8787
# STORYFORGE_PUBLIC_HOST=scanlogic-storyforge.fly.dev
# STORYFORGE_SERVE_STATIC=1
# STORYFORGE_WEB_DIST=/absolute/path/to/apps/web/dist

# Redis for BullMQ (optional in dev — in-process queue used when unset)
# REDIS_URL=redis://127.0.0.1:6379

# Postgres (optional — memory store used when unset)
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/storyforge

# Stripe (optional — billing routes stubbed until set)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_CREATOR=
# STRIPE_PRICE_STUDIO=

# ─── Image provider (real AI gens + 2.5× print upscale) ───────────────────────
# mock = local SVG placeholders (default, free, no key)
# replicate = RECOMMENDED for Neolemon-like path (one API token)
# fal = alternate (strong float upscale_factor on clarity-upscaler)
STORYFORGE_IMAGE_PROVIDER=mock

# ▶ RECOMMENDED: Replicate
# 1) Create token: https://replicate.com/account/api-tokens
# 2) Set provider + token below
# 3) Restart API — Character Turbo / Editor Pro / 2.5× upscale call live models
# STORYFORGE_IMAGE_PROVIDER=replicate
# REPLICATE_API_TOKEN=r8_...
# Optional model overrides (defaults are production-ready):
# REPLICATE_MODEL_GENERATE=black-forest-labs/flux-schnell
# REPLICATE_MODEL_IMG2IMG=black-forest-labs/flux-redux-dev
# REPLICATE_MODEL_UPSCALE=nightmareai/real-esrgan

# ▶ fal.ai — full catalogue (images + video + print) — Studio pickers override per project
# Docs: https://fal.ai/docs/documentation · Keys: https://fal.ai/dashboard/keys
# STORYFORGE_IMAGE_PROVIDER=fal
# FAL_KEY=...
# Character Turbo defaults (also: fal-ai/flux/dev, fal-ai/flux-2-pro, fal-ai/nano-banana-2, fal-ai/z-image/turbo):
# FAL_MODEL_GENERATE=fal-ai/flux/schnell
# Editor Pro — Kontext Pro recommended (also: fal-ai/flux/dev/image-to-image):
# FAL_MODEL_IMG2IMG=fal-ai/flux-pro/kontext
# FAL_IMG2IMG_STRENGTH=0.65
# Print upscale:
# FAL_MODEL_UPSCALE=fal-ai/clarity-upscaler
# Scene → video — Kling Pro i2v default (also: standard i2v, Kling Pro t2v, fal-ai/veo3.1, Seedance):
# FAL_MODEL_VIDEO=fal-ai/kling-video/v3/pro/image-to-video
# FAL_VIDEO_DURATION=5
# FAL_VIDEO_TIMEOUT_MS=480000
# Signed export download TTL (ms):
# STORYFORGE_EXPORT_TTL_MS=7200000

# Free trial credits granted on first desktop session (100 ≈ full mock book loop)
STORYFORGE_TRIAL_CREDITS=100

# Persist projects/credits under storyforge/.data (local operational use)
STORYFORGE_PERSIST=1
# STORYFORGE_DATA_PATH=/absolute/path/to/state.json

# Hard daily spend cap in credits (abuse control)
STORYFORGE_DAILY_CREDIT_CAP=500

# Desktop minimum viewport (must match client gate)
STORYFORGE_DESKTOP_MIN_WIDTH=1024
