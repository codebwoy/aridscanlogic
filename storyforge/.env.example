# StoryForge — server secrets only. Never use VITE_ for secrets.
# Generate: openssl rand -base64 48

# HMAC signing for desktop studio sessions (required in production)
STORYFORGE_SESSION_SECRET=replace-with-long-random-string

# Optional shared secret for non-local API access (Bearer)
STORYFORGE_API_SECRET=

# Public web origin (CORS allowlist). Comma-separated.
STORYFORGE_WEB_ORIGIN=http://localhost:5180

# API listen
STORYFORGE_API_HOST=127.0.0.1
STORYFORGE_API_PORT=8787

# Redis for BullMQ (optional in dev — in-process queue used when unset)
# REDIS_URL=redis://127.0.0.1:6379

# Postgres (optional — memory store used when unset)
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/storyforge

# Stripe (optional — billing routes stubbed until set)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_CREATOR=
# STRIPE_PRICE_STUDIO=

# Image provider (mock | fal | replicate …). Default mock for local/dev.
STORYFORGE_IMAGE_PROVIDER=mock
# FAL_KEY=
# REPLICATE_API_TOKEN=

# Free trial credits granted on first desktop session
STORYFORGE_TRIAL_CREDITS=20

# Hard daily spend cap in credits (abuse control)
STORYFORGE_DAILY_CREDIT_CAP=500

# Desktop minimum viewport (must match client gate)
STORYFORGE_DESKTOP_MIN_WIDTH=1024
