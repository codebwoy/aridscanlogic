# Oracle Cloud Always Free — hybrid studios (AuthorForge + StoryForge)
# Copy to deploy/oracle/.env on the VM (never commit real secrets).
# Generate secrets: openssl rand -base64 48

# ─── Public hostnames (DNS A/AAAA → your OCI public IP) ─────────────────────
# Caddy issues Let's Encrypt certs for these names.
AUTHORFORGE_HOST=authorforge.example.com
STORYFORGE_HOST=storyforge.example.com
# Optional contact for ACME / Let's Encrypt
ACME_EMAIL=you@example.com

# ─── AuthorForge ────────────────────────────────────────────────────────────
AUTHORFORGE_SESSION_SECRET=replace-with-long-random-string
AUTHORFORGE_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Comma-separated: studio URL + ScanLogic production URLs (CORS / Hub probe)
AUTHORFORGE_WEB_ORIGIN=https://authorforge.example.com,https://aridscanlogic.cycroommedia.com,https://aridscanlogic-tau.vercel.app

# ─── StoryForge ─────────────────────────────────────────────────────────────
STORYFORGE_SESSION_SECRET=replace-with-long-random-string
STORYFORGE_IMAGE_PROVIDER=mock
# REPLICATE_API_TOKEN=r8_...
STORYFORGE_WEB_ORIGIN=https://storyforge.example.com,https://aridscanlogic.cycroommedia.com,https://aridscanlogic-tau.vercel.app
