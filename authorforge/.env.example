# AuthorForge — server secrets only. Never use VITE_ for secrets.
# Generate: openssl rand -base64 48

# HMAC signing for desktop studio sessions (required in production)
AUTHORFORGE_SESSION_SECRET=replace-with-long-random-string

# Optional shared secret for non-local API access (Bearer)
AUTHORFORGE_API_SECRET=

# Public web origin (CORS allowlist). Include ScanLogic Vite ports for Amazon Hub /health probe.
AUTHORFORGE_WEB_ORIGIN=http://localhost:5181,http://127.0.0.1:5181,http://localhost:5173,http://127.0.0.1:5173

# API listen (production/Docker: host 0.0.0.0 via NODE_ENV=production; PORT/8080 on Fly)
AUTHORFORGE_API_HOST=127.0.0.1
AUTHORFORGE_API_PORT=8788
# AUTHORFORGE_PUBLIC_HOST=authorforge.example.com
# (Fly standby: scanlogic-authorforge.fly.dev)
# Serve built SPA from apps/web/dist (hybrid container)
# AUTHORFORGE_SERVE_STATIC=1
# AUTHORFORGE_WEB_DIST=/absolute/path/to/apps/web/dist

# Redis for BullMQ (optional — in-process queue when unset)
# REDIS_URL=redis://127.0.0.1:6379

# Postgres (optional — memory store when unset)
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/authorforge

# ─── LLM (Recommendation C: AuthorForge owns the gateway) ───────────────────
# fake = deterministic fixtures (default for tests / offline)
# anthropic = direct Anthropic SDK call from AuthorForge API (not ScanLogic /api/llm)
AUTHORFORGE_LLM_PROVIDER=fake
# Same key as ScanLogic is OK — do NOT put in VITE_*
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# AUTHORFORGE_MODEL_DRAFT=claude-sonnet-4-6
# AUTHORFORGE_MODEL_CHEAP=claude-haiku-4-5-20251001
# AUTHORFORGE_MODEL_POLISH=claude-opus-4-6

# Budget cap per book (EUR estimate for display)
AUTHORFORGE_BOOK_BUDGET_EUR=8

# Stripe (storefront + SaaS credits — test mode)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_BOOK_CREDIT=

# Market data (Phase 8) — mock by default; never scrape Amazon
AUTHORFORGE_MARKET_PROVIDER=mock
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# Image / cover (Phase 6)
AUTHORFORGE_IMAGE_PROVIDER=mock
# REPLICATE_API_TOKEN=

# Originality (Phase 4) — internal n-gram by default
AUTHORFORGE_ORIGINALITY_PROVIDER=internal

# Fact-check search (Phase 4) — mock by default; never auto-marks verified
AUTHORFORGE_SEARCH_PROVIDER=mock
# TAVILY_API_KEY=


# Credits
AUTHORFORGE_TRIAL_CREDITS=200
AUTHORFORGE_DAILY_CREDIT_CAP=800
AUTHORFORGE_DESKTOP_MIN_WIDTH=1024

# Persist books/credits under authorforge/.data
AUTHORFORGE_PERSIST=1
# AUTHORFORGE_DATA_PATH=/absolute/path/to/state.json

# Signed export / download TTL (ms)
AUTHORFORGE_EXPORT_TTL_MS=7200000
